$TTL 3600
$ORIGIN final.test.

; SOA Record
@       IN      SOA     ns1.final.test. admin.final.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.final.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.125
www     IN      A       192.0.2.125
mail    IN      A       192.0.2.225
@       IN      MX      10 mail.final.test.
@       IN      TXT     "Example zone final.test"
