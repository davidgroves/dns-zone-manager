$TTL 3600
$ORIGIN nu.test.

; SOA Record
@       IN      SOA     ns1.nu.test. admin.nu.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.nu.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.113
www     IN      A       192.0.2.113
mail    IN      A       192.0.2.213
@       IN      MX      10 mail.nu.test.
@       IN      TXT     "Example zone nu.test"
