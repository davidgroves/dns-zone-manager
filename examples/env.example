# DNS API Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# DNS Server Configuration
# =============================================================================

# DNS server hostname or IP address.
# A hostname (e.g. the Docker Compose service name "bind") is resolved to an
# IP at startup, so no static network address is required.
DNS_SERVER=bind

# DNS server port (standard is 53)
DNS_PORT=53

# Query timeout in seconds
DNS_TIMEOUT=2.0

# AXFR zone transfer timeout in seconds
DNS_AXFR_TIMEOUT=60.0

# =============================================================================
# TSIG Key Configuration (for authenticated DDNS updates)
# =============================================================================

# TSIG key name (must match the key name in BIND's named.conf)
TSIG_KEY_NAME=dns-api-key

# TSIG key secret (base64 encoded, must match named.conf)
# Generate a new key with: tsig-keygen -a hmac-sha256 dns-api-key
TSIG_KEY_SECRET=K8vC2mP9nQ4rT6wX1yB3fG5hJ7kL0mN2pR4sU6vW8xY=

# TSIG algorithm (hmac-sha256, hmac-sha384, hmac-sha512, hmac-md5)
TSIG_KEY_ALGORITHM=hmac-sha256

# =============================================================================
# API Key Authentication
# =============================================================================

# Enable API key authentication
API_KEY_AUTH_ENABLED=true

# Named API keys in format: name:secret,name:secret
# The name is used in audit logs to identify who made changes
# Example: alice:demo-api-key-12345,bob:another-key-67890
API_KEYS=alice:demo-api-key-12345,bob:another-key-67890

# Header name for API key (default: X-API-Key)
API_HEADER_NAME=X-API-Key

# =============================================================================
# Azure AD Authentication (optional)
# =============================================================================

# Enable Azure AD authentication
AZURE_AD_AUTH_ENABLED=false

# Azure AD tenant ID
AZURE_AD_TENANT_ID=

# Azure AD application client ID
AZURE_AD_CLIENT_ID=

# OAuth2 scopes (comma-separated)
AZURE_AD_SCOPES=api://dns-api/.default

# =============================================================================
# Zone Cache Configuration
# =============================================================================

# Enable zone caching (improves performance)
CACHE_ENABLED=true

# Minimum zone refresh interval in seconds (floor for SOA refresh)
# Zones with SOA refresh < this value will use this as their refresh interval
CACHE_MIN_REFRESH_INTERVAL=60

# Maximum zone refresh interval in seconds (ceiling for SOA refresh)
# Zones with SOA refresh > this value will use this as their refresh interval
CACHE_MAX_REFRESH_INTERVAL=86400

# =============================================================================
# Catalog Zone Configuration (optional - for automatic zone discovery)
# =============================================================================

# Enable catalog zone auto-discovery
CATALOG_ENABLED=true

# Catalog zone name (RFC 9432)
CATALOG_ZONE_NAME=catalog.example.

# Polling interval for SOA serial checks (seconds)
CATALOG_POLL_INTERVAL=300

# NOTIFY listener bind address
CATALOG_NOTIFY_BIND_ADDRESS=0.0.0.0

# NOTIFY listener ports (different from main DNS port to avoid conflicts)
CATALOG_NOTIFY_UDP_PORT=5354
CATALOG_NOTIFY_TCP_PORT=5354

# Automatically AXFR zones discovered from catalog
CATALOG_AUTO_LOAD_ZONES=true

# Remove zones from cache when removed from catalog
CATALOG_REMOVE_STALE_ZONES=true

# =============================================================================
# Application Settings
# =============================================================================

# Application name (shown in API docs)
APP_NAME=DNS Record Management API

# Enable debug mode
DEBUG=true

# =============================================================================
# Logging Configuration (Structured JSON Wide Events)
# =============================================================================

# Log format: 'json' for structured JSON output, 'text' for human-readable
# Use 'text' for local development, 'json' for production
LOG_FORMAT=json

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sample rate for successful GET requests (0.0-1.0)
# Mutations (POST/PUT/DELETE), errors, and slow requests are always logged
LOG_SAMPLE_RATE=1

# Always log requests slower than this (milliseconds)
LOG_SLOW_THRESHOLD_MS=1000

