$TTL 3600
$ORIGIN upsilon.test.

; SOA Record
@       IN      SOA     ns1.upsilon.test. admin.upsilon.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.upsilon.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.120
www     IN      A       192.0.2.120
mail    IN      A       192.0.2.220
@       IN      MX      10 mail.upsilon.test.
@       IN      TXT     "Example zone upsilon.test"
