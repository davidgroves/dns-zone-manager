$TTL 3600
$ORIGIN gamma.test.

; SOA Record
@       IN      SOA     ns1.gamma.test. admin.gamma.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.gamma.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.103
www     IN      A       192.0.2.103
mail    IN      A       192.0.2.203
@       IN      MX      10 mail.gamma.test.
@       IN      TXT     "Example zone gamma.test"
