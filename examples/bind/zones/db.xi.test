$TTL 3600
$ORIGIN xi.test.

; SOA Record
@       IN      SOA     ns1.xi.test. admin.xi.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.xi.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.114
www     IN      A       192.0.2.114
mail    IN      A       192.0.2.214
@       IN      MX      10 mail.xi.test.
@       IN      TXT     "Example zone xi.test"
