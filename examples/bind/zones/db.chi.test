$TTL 3600
$ORIGIN chi.test.

; SOA Record
@       IN      SOA     ns1.chi.test. admin.chi.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.chi.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.122
www     IN      A       192.0.2.122
mail    IN      A       192.0.2.222
@       IN      MX      10 mail.chi.test.
@       IN      TXT     "Example zone chi.test"
