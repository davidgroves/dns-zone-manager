$TTL 3600
$ORIGIN iota.test.

; SOA Record
@       IN      SOA     ns1.iota.test. admin.iota.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.iota.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.109
www     IN      A       192.0.2.109
mail    IN      A       192.0.2.209
@       IN      MX      10 mail.iota.test.
@       IN      TXT     "Example zone iota.test"
