$TTL 3600
$ORIGIN kappa.test.

; SOA Record
@       IN      SOA     ns1.kappa.test. admin.kappa.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.kappa.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.110
www     IN      A       192.0.2.110
mail    IN      A       192.0.2.210
@       IN      MX      10 mail.kappa.test.
@       IN      TXT     "Example zone kappa.test"
