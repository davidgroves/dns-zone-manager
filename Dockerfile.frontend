# Frontend Dockerfile
# Builds the Vite SPA and serves it with unprivileged nginx

# Build stage
FROM node:24-slim AS builder

WORKDIR /app

# Version injected at build time by the release pipeline (the git tag, e.g. 0.2.0).
# The image build has no .git, so we set the version explicitly instead of using
# the git-based "version:sync" npm script.
ARG VERSION=0.0.0

# Copy package files and install dependencies
COPY package.json package-lock.json* ./
RUN npm install

# Copy TypeScript source and config
COPY tsconfig.json vite.config.ts ./
COPY frontend/ ./frontend/

# Build the SPA (bypasses version:sync; no git history available in the image).
# Strip a leading "v" so a git tag like v0.2.0 yields a valid npm version.
RUN VER="${VERSION#v}" && npm pkg set version="$VER" && npx tsc && npx vite build

# Runtime stage with unprivileged nginx (listens on 8080, non-root)
FROM nginxinc/nginx-unprivileged:1.29-alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config (listens on 8080 for the unprivileged image)
COPY examples/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
