$TTL 3600
$ORIGIN rho.test.

; SOA Record
@       IN      SOA     ns1.rho.test. admin.rho.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.rho.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.117
www     IN      A       192.0.2.117
mail    IN      A       192.0.2.217
@       IN      MX      10 mail.rho.test.
@       IN      TXT     "Example zone rho.test"
