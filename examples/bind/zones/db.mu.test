$TTL 3600
$ORIGIN mu.test.

; SOA Record
@       IN      SOA     ns1.mu.test. admin.mu.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.mu.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.112
www     IN      A       192.0.2.112
mail    IN      A       192.0.2.212
@       IN      MX      10 mail.mu.test.
@       IN      TXT     "Example zone mu.test"
