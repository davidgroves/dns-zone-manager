$TTL 3600
$ORIGIN phi.test.

; SOA Record
@       IN      SOA     ns1.phi.test. admin.phi.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.phi.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.121
www     IN      A       192.0.2.121
mail    IN      A       192.0.2.221
@       IN      MX      10 mail.phi.test.
@       IN      TXT     "Example zone phi.test"
