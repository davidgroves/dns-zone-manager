# Frontend Dockerfile
# Builds the Vite SPA and serves it with nginx

# Build stage
FROM node:22-slim AS builder

WORKDIR /app

# Version injected at build time by the release pipeline (the git tag, e.g. 0.2.0).
# The image build has no .git, so we set the version explicitly instead of using
# the git-based "version:sync" npm script.
ARG VERSION=0.0.0

# Copy package files and install dependencies
COPY package.json package-lock.json* ./
RUN npm install

# Copy TypeScript source and config
COPY tsconfig.json vite.config.ts ./
COPY frontend/ ./frontend/

# Build the SPA (bypasses version:sync; no git history available in the image)
RUN npm pkg set version="$VERSION" && npx tsc && npx vite build

# Runtime stage with nginx
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY examples/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
