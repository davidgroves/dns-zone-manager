$TTL 3600
$ORIGIN pi.test.

; SOA Record
@       IN      SOA     ns1.pi.test. admin.pi.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.pi.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.116
www     IN      A       192.0.2.116
mail    IN      A       192.0.2.216
@       IN      MX      10 mail.pi.test.
@       IN      TXT     "Example zone pi.test"
