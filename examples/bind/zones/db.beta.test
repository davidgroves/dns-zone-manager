$TTL 3600
$ORIGIN beta.test.

; SOA Record
@       IN      SOA     ns1.beta.test. admin.beta.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.beta.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.102
www     IN      A       192.0.2.102
mail    IN      A       192.0.2.202
@       IN      MX      10 mail.beta.test.
@       IN      TXT     "Example zone beta.test"
