// BIND configuration for DNS API examples
// This configuration is for development/testing purposes only

options {
    directory "/var/cache/bind";
    
    // Listen on non-privileged port for dev (avoids root, conflicts)
    listen-on port 15353 { any; };
    listen-on-v6 port 15353 { any; };
    
    // Allow queries from anywhere (dev only!)
    allow-query { any; };
    
    // Disable recursion - authoritative only
    recursion no;
    allow-recursion { none; };
    
    // Disable DNSSEC validation for simplicity
    dnssec-validation no;
    
    // Query logging disabled - see logging section
    // (dnspython's Resolver queries root zone which creates noise)
    querylog no;
    
    // Send NOTIFY to the local API server for zone updates (dev mode)
    notify explicit;
    also-notify { 127.0.0.1 port 15354; };

    // Do IXFR
    provide-ixfr yes;
    
    // Zone history feature: Force IXFR generation even when AXFR would be more efficient
    // This enables the zone history API to retrieve incremental changes
    // Note: Adds CPU/memory overhead as BIND computes and stores difference sets
    ixfr-from-differences yes;
    
    // Keep more journal history for zone history feature (default is limited)
    max-journal-size 100M;

    // Return IXFR's even if AXFR would just be quicker.
    // This implements the history feature.
    max-ixfr-ratio unlimited;
    
    // Use Unix timestamp for SOA serial numbers (automatic updates)
    serial-update-method unixtime;
};

// TSIG key for authenticated dynamic updates
key "dns-api-key" {
    algorithm hmac-sha256;
    secret "K8vC2mP9nQ4rT6wX1yB3fG5hJ7kL0mN2pR4sU6vW8xY=";
};

// RNDC key for server administration
key "rndc-key" {
    algorithm hmac-sha256;
    secret "xT7J2kLpN9qRvW4mY8sF1gH5bC3dE6aZ0iO7uP2wX4c=";
};

// Remote control configuration
controls {
    inet * port 953 allow { 127.0.0.1; 172.28.0.0/16; } keys { "rndc-key"; };
};

// Logging configuration
logging {
    channel default_log {
        stderr;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };
    channel update_log {
        stderr;
        severity debug;
        print-time yes;
        print-category yes;
    };
    // Null channel to discard noisy logs (like root zone query refusals)
    channel null_log {
        null;
    };
    category default { default_log; };
    category update { update_log; };
    category xfer-in { default_log; };
    category xfer-out { default_log; };
    category security { default_log; };
    // Suppress query logging - root zone REFUSED messages are noisy
    // dnspython's Resolver queries . SOA which gets refused
    category queries { null_log; };
};

// Zone: example.com - General purpose example zone
zone "example.com" {
    type primary;
    file "/var/lib/bind/db.example.com";
    allow-update { key "dns-api-key"; };
    allow-transfer { key "dns-api-key"; };
};

