$TTL 3600
$ORIGIN epsilon.test.

; SOA Record
@       IN      SOA     ns1.epsilon.test. admin.epsilon.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.epsilon.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.105
www     IN      A       192.0.2.105
mail    IN      A       192.0.2.205
@       IN      MX      10 mail.epsilon.test.
@       IN      TXT     "Example zone epsilon.test"
