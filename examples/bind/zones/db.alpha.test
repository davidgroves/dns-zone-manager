$TTL 3600
$ORIGIN alpha.test.

; SOA Record
@       IN      SOA     ns1.alpha.test. admin.alpha.test. (
                        1                       ; Serial
                        3600            ; refresh
                        600             ; retry
                        604800          ; expire
                        300             ; minimum TTL
                        )

; Name Server
@       IN      NS      ns1.alpha.test.
ns1     IN      A       192.0.2.1

; Basic records
@       IN      A       192.0.2.101
www     IN      A       192.0.2.101
mail    IN      A       192.0.2.201
@       IN      MX      10 mail.alpha.test.
@       IN      TXT     "Example zone alpha.test"
